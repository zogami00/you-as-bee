[Unit]
Description=you-as-bee USB-over-LAN agent
Documentation=https://github.com/zogami00/you-as-bee
Wants=network-online.target usbipd.service
After=network-online.target usbipd.service systemd-udevd.service
# Never give up restarting: losing the agent on a headless Pi is worse than a
# restart loop, and the device state is recovered by the reconciler.
StartLimitIntervalSec=0

[Service]
Type=notify
WatchdogSec=30
Restart=always
RestartSec=2
ExecStart=/usr/local/bin/yabd run --config /etc/you-as-bee/agent.json
User=root
Group=root
# Hardening. The agent must write sysfs to bind devices, read its config and
# token from /etc, and have a state directory, and nothing else.
#
# StateDirectory= and ConfigurationDirectory= make systemd create and own
# /var/lib/you-as-bee and /etc/you-as-bee before the mount namespace is set up.
# They must NOT be listed in ReadWritePaths= as well: ReadWritePaths= is applied
# first and, under ProtectSystem=strict, a path there that does not already
# exist makes the unit die with 226/NAMESPACE and crash-loop forever. Letting
# systemd own those directories removes that ordering hazard.
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/sys
StateDirectory=you-as-bee
ConfigurationDirectory=you-as-bee
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
