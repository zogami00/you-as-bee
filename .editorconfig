# EditorConfig - https://editorconfig.org
# Applies to every editor that understands EditorConfig.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

# Go is formatted with tabs (gofmt).
[*.go]
indent_style = tab
indent_size = 4

# Windows PowerShell scripts must keep CRLF; Linux shell units use LF.
[*.ps1]
end_of_line = crlf

[*.{sh,service,rules}]
end_of_line = lf

[*.{md,markdown}]
trim_trailing_whitespace = false

[*.{yml,yaml}]
indent_size = 2
